{
  "manifest_version": 3,
  "name": "Instagram Quiet",
  "version": "1.1.0",
  "description": "Убирает навязчивые окна входа и открытия приложения на Instagram.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Instagram Quiet",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["https://instagram.com/*", "https://www.instagram.com/*", "https://m.instagram.com/*"],
    "js": ["rules.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_start"
  }]
}
